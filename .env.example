# Portfolio Environment Variables
# Copy this file to .env.local and fill in your actual values

# Optional canonical site URL. Vercel supplies its deployment URL automatically.
# NEXT_PUBLIC_SITE_URL=https://portfolio.example.com

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Required by server-only AI, contact, CV, sync and scheduled-job operations.
# Never expose this in client-side code.
SUPABASE_SECRET_KEY=your-secret-key-here

# Backwards compatibility with older setup docs in this repo.
# SUPABASE_ANON_KEY=your-publishable-key-here

# ===========================================
# NVIDIA AI CONFIGURATION (Required for the portfolio chatbot and code review)
# ===========================================
# Rotate any key that was pasted into chat or logs. Store fresh keys only here
# locally and in hosting platform secrets.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Simple setup: one key can power chat, code review, fallback, and embeddings.
# NVIDIA_API_KEY=your-nvidia-api-key-here

# Advanced setup: use separate keys per model/workload.
# NVIDIA_CV_CHAT_API_KEY=your-glm-key-here
# NVIDIA_CODE_REVIEW_API_KEY=your-deepseek-key-here
# NVIDIA_FALLBACK_API_KEY=your-qwen-key-here
# NVIDIA_EMBEDDING_API_KEY=your-embedding-key-here

NVIDIA_CV_CHAT_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_CODE_REVIEW_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.2-3b-instruct
NVIDIA_STABLE_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2

# Optional portfolio chatbot retrieval tuning. Score settings are clamped to 0-1.
# RAG_MATCH_THRESHOLD=0.28
# RAG_RELATIVE_SCORE_MARGIN=0.14

# Distributed abuse protection and lazy invisible Turnstile. In production,
# all five automation/security values must be unique and at least 32 UTF-8
# bytes. Generate each independently, for example with `openssl rand -hex 32`.
RATE_LIMIT_PEPPER=generate-a-long-random-secret
SESSION_COOKIE_SECRET=generate-a-different-long-random-secret
# Optional for trusted self-hosted reverse proxies only. Never set this to a
# public client-controlled header unless your proxy overwrites incoming copies.
# TRUSTED_PROXY_IP_HEADER=x-real-ip
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=portfolio.example.com

# Protected scheduled endpoints and GitHub synchronization.
CRON_SECRET=generate-a-long-random-secret
RAG_JOB_SECRET=generate-a-different-long-random-secret
CANONICAL_SITE_URL=https://portfolio.example.com

# Optional extra fallbacks. Keep fresh rotated keys server-side only.
# NVIDIA_DEEPSEEK_PRO_API_KEY=your-deepseek-pro-key-here
# NVIDIA_DEEPSEEK_PRO_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_LLAMA_31_70B_API_KEY=your-llama-31-70b-key-here
# NVIDIA_LLAMA_31_70B_MODEL=meta/llama-3.1-70b-instruct

# ===========================================
# EMAIL CONFIGURATION (Required)
# ===========================================
# Email address to receive contact form submissions
CONTACT_TO=your-email@example.com

# Optional: Customize email subject and sender
CONTACT_SUBJECT="Message from your portfolio page"
MAIL_FROM="Portfolio <no-reply@localhost>"

# ===========================================
# SMTP SERVER CONFIGURATION (Required)
# ===========================================
# For Gmail, use:
# - Host: smtp.gmail.com
# - Port: 587
# - Create App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Set to "false" for non-SSL connections (port 587)
SMTP_SECURE=false

# Secret for the internal cache invalidation endpoint. Generate a long random value.
REVALIDATE_SECRET=

# Private, versions-named CV object used by /api/cv.
CV_STORAGE_BUCKET=private-cv
CV_STORAGE_OBJECT=cv/Mouaz-Naji-CV-2026-08.pdf

# ===========================================
# NOTES
# ===========================================
# - Never commit any .env file to git (.gitignore allows only .env.example)
# - For production, set these in your hosting platform (Vercel, Netlify, etc.)
# - Restart dev server after changing environment variables
