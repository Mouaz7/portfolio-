{
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.8",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "knip": "6.36.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "license": "UNLICENSED",
  "name": "mouaz-naji-portfolio",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "node scripts/run-dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:dead": "knip",
    "sync:projects": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-projects-from-github.mts",
    "start": "next start",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:csp-report-only": "node scripts/inspect-csp-report-only.mjs",
    "test:coverage": "jest --coverage",
    "test:design-lock": "node scripts/check-design-lock.mjs",
    "test:pixel-lock": "node scripts/check-pixel-lock.mjs",
    "test:lighthouse": "node scripts/run-lighthouse-ci.mjs",
    "test:licenses": "node scripts/audit-dependency-licenses.mjs",
    "test:motion-performance": "node scripts/measure-motion-performance.mjs",
    "test:navigation-performance": "node scripts/measure-navigation-performance.mjs",
    "test:secrets": "bash scripts/scan-git-history.sh",
    "test:secrets:gitleaks": "bash scripts/run-gitleaks-history.sh",
    "test:e2e": "playwright test"
  },
  "version": "0.1.0",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
